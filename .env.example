NODE_ENV=production
PORT=8083
# Gateway -> domain backend route inside the Tier-3 product stack.
CITY_SERVICE_URL=http://city-service:8083
# Public Tier-2 URL. Do not set this to a private port or localhost.
SYNAPSEDX_BASE_URL=https://synapsedx.sbs
# A scoped Tier-2 service key is recommended for private record writes.
SYNAPSEDX_API_KEY=
SYNAPSEDX_TOKEN=
CORS_ORIGIN=https://synapsecity.sbs
ALLOW_LOCAL_DEPENDENCIES=false
