# Public GHCR images: ghcr.io/<owner>/synapsecity-<service>:<version>.
# Pin a release tag for reproducible self-hosting, or keep `latest`.
SYNAPSECITY_VERSION=latest
SYNAPSECITY_IMAGE_OWNER=vku-open-source-2026

NODE_ENV=production
# city-service container port. This is internal to the SynapseCity stack and is
# not published on the host.
PORT=8083
# Host port used to reach the gateway container (which always listens on 8080).
GATEWAY_HOST_PORT=8085
# Gateway -> domain backend route inside the Tier-3 product stack.
CITY_SERVICE_URL=http://city-service:8083
# Gateway -> console route inside the Tier-3 product stack.
CONSOLE_URL=http://console:80
# Public Tier-2 URL. Do not set this to a private port or localhost.
SYNAPSEDX_BASE_URL=https://synapsedx.sbs
# A scoped Tier-2 service key is recommended for private record writes.
SYNAPSEDX_API_KEY=
SYNAPSEDX_TOKEN=
# Tier-3 login, registration and sessions are retired: every /v1/auth/* path
# answers 410 workspace_moved and login belongs to the SynapseDX workspace
# (https://synapsedx.sbs/workspace). There is no City auth mode, demo shell,
# bootstrap-admin email list or delegated-token exchange to configure.
# Optional HMAC secret for the City session. When unset the service generates
# an ephemeral secret at startup (sessions end on restart).
AUTH_SECRET=
# Public base URL used to build stored file download URLs.
CITY_PUBLIC_URL=https://synapsecity.sbs
# Server-side file limits. Keep below the Tier-2 files limit and the edge body
# limit (infra/nginx sets client_max_body_size 26m, matching the gateway).
CITY_FILES_MAX_BYTES=10485760
CITY_PHOTO_MAX_BYTES=10485760
# Send email/SMS/push through the Tier-2 notifications capability when the
# recipient has a City profile address. Off = in-app projection only.
CITY_NOTIFY_EXTERNAL=false
# Geocoding and map tiles are Tier-2 capabilities. City holds no provider key
# and has no local VietMap/OpenStreetMap fallback.
# Fixed-window rate limits for auth and anonymous reporting endpoints.
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MS=300000
PUBLIC_RATE_LIMIT=40
PUBLIC_RATE_WINDOW_MS=600000
# Anonymous public reads (assets/incidents) get their own 60-second bucket.
PUBLIC_READ_RATE_LIMIT=300
# Turnstile is verified by the Tier-2 security capability. Set
# REQUIRE_TURNSTILE=true to fail closed when Tier 2 has no provider configured.
REQUIRE_TURNSTILE=false
# Optional bearer token required to scrape /metrics.
METRICS_TOKEN=
# Production service logs use RUST_LOG (tracing env-filter), e.g. `info` or
# `info,synapsecity_city_service=debug`. LOG_LEVEL only ever configured the
# legacy TS reference server and is not read by the Rust build.
# RUST_LOG=info
# A sensor with no reading newer than this is reported offline.
IOT_OFFLINE_THRESHOLD_MINUTES=15
CORS_ORIGIN=https://synapsecity.sbs
ALLOW_LOCAL_DEPENDENCIES=false

# Contribution portal (contribution.synapsecity.sbs), owned by SynapseCity.
# Source migrated from the OpenInfra reference implementation; OpenInfra is
# not a deployment source.
CONTRIBUTION_STORAGE_BACKEND=base
CONTRIBUTION_SYNAPSEONE_BASE_URL=https://api.synapseone.space
CONTRIBUTION_SYNAPSEONE_API_KEY=
CONTRIBUTION_SYNC_SHARED_SECRET=
CONTRIBUTION_VIETMAP_API_KEY=
CONTRIBUTION_JWT_SECRET_KEY=
CONTRIBUTION_ADMIN_USERNAME=admin
CONTRIBUTION_ADMIN_PASSWORD=
CONTRIBUTION_CORS_ORIGINS=https://contribution.synapsecity.sbs
