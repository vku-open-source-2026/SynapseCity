NODE_ENV=production
# city-service container port. This is internal to the SynapseCity stack and is
# not published on the host.
PORT=8083
# Host port used to reach the gateway container (which always listens on 8080).
GATEWAY_HOST_PORT=8085
# Gateway -> domain backend route inside the Tier-3 product stack.
CITY_SERVICE_URL=http://city-service:8083
# Gateway -> console route inside the Tier-3 product stack.
CONSOLE_URL=http://console:80
# Public Tier-2 URL. Do not set this to a private port or localhost.
SYNAPSEDX_BASE_URL=https://synapsedx.sbs
# A scoped Tier-2 service key is recommended for private record writes.
SYNAPSEDX_API_KEY=
# Server-side VIETMAP key. Never expose this as VITE_* or commit the value.
VIETMAP_API_KEY=
VIETMAP_TILE_STYLE=tm
SYNAPSEDX_TOKEN=
# Identity source: tier2 (default, Tier-2 auth capability -> Tier-1 IAM) or
# demo (explicit development-only shell).
CITY_AUTH_MODE=tier2
# Optional HMAC secret for the City session. When unset the service generates
# an ephemeral secret at startup (sessions end on restart).
AUTH_SECRET=
# Comma-separated emails granted the City admin role when they authenticate
# through Tier-2. This is server-side configuration, never a request field.
CITY_BOOTSTRAP_ADMIN_EMAILS=
# Optional delegated-token exchange after Tier-2 login. Only enable when the
# service credential is allowed to mint synapsecity-audience tokens.
CITY_AUTH_EXCHANGE=false
CITY_AUTH_EXCHANGE_SCOPES=read,write
# Default City role for a verified identity with no operator profile.
CITY_AUTH_DEFAULT_ROLE=citizen
# Demo credential login is only reachable with CITY_AUTH_MODE=demo and this
# flag "true". Never enable it on an Internet-facing deployment.
AUTH_DEMO_MODE=false
# Role granted by the demo shell (admin|manager|technician|volunteer|citizen).
# Operators configure this server-side; request bodies can never select a role.
AUTH_DEMO_ROLE=admin
# Public base URL used to build stored file download URLs.
CITY_PUBLIC_URL=https://synapsecity.sbs
# Server-side file limits. Keep below the Tier-2 files limit and the edge body
# limit (the reference nginx caps requests at 25 MiB).
CITY_FILES_MAX_BYTES=10485760
CITY_PHOTO_MAX_BYTES=10485760
# Send email/SMS/push through the Tier-2 notifications capability when the
# recipient has a City profile address. Off = in-app projection only.
CITY_NOTIFY_EXTERNAL=false
# Geocoding provider: tier2 (shared adapter, default) or vietmap (legacy
# City-local tile/geocode integration). Fallback is opt-in and off by default.
CITY_GEO_PROVIDER=tier2
CITY_GEO_FALLBACK_VIETMAP=false
# Fixed-window rate limits for auth and anonymous reporting endpoints.
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MS=300000
PUBLIC_RATE_LIMIT=40
PUBLIC_RATE_WINDOW_MS=600000
# Cloudflare Turnstile. Set the secret to verify tokens server-side; set
# REQUIRE_TURNSTILE=true to fail closed when the secret is missing.
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
REQUIRE_TURNSTILE=false
# Optional bearer token required to scrape /metrics.
METRICS_TOKEN=
# Structured request logs: info|silent.
LOG_LEVEL=info
# A sensor with no reading newer than this is reported offline.
IOT_OFFLINE_THRESHOLD_MINUTES=15
CORS_ORIGIN=https://synapsecity.sbs
ALLOW_LOCAL_DEPENDENCIES=false
