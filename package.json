{
  "name": "synapsecity",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "SynapseCity Tier-3 infrastructure product migrated from OpenInfra",
  "type": "commonjs",
  "scripts": {
    "prebuild": "npm --prefix ../SynapseDX/sdk-js install && npm --prefix ../SynapseDX/sdk-js run build",
