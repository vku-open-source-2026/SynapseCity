{
  "name": "synapsecity",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "SynapseCity Tier-3 infrastructure product migrated from OpenInfra",
  "workspaces": [
    "apps/city-service",
    "apps/console",
    "apps/gateway"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:service": "npm run build --workspace=@synapsecity/city-service",
    "start:service": "npm run start --workspace=@synapsecity/city-service",
    "check:release": "node scripts/check-release.cjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "import:openinfra": "node scripts/import-openinfra.mjs",
    "workflows:validate": "node workflows/validate.mjs",
    "build:contribution": "npm --prefix apps/contribution-console run build",
    "dev:contribution": "npm --prefix apps/contribution-console run dev"
  }
}
