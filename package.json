  "dependencies": {
    "@synapsedx/capabilities": "file:../SynapseDX/sdk-js",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
