{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "city",
    "name": "City volunteer desk",
    "slug": "city-volunteer-desk",
    "audience": "member",
    "roles": [
      "volunteer"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "See the current incident and alert picture and report a new infrastructure issue. Volunteer access is read-only apart from the report form, which creates a reviewable City incident.",
        "type": "heading",
        "title": "Community operations desk",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:city-operations-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Assets",
            "target": "page:city-asset-registry",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Incidents",
            "target": "page:city-incident-desk",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Maintenance",
            "target": "page:city-maintenance-workshop",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "incidents-metric",
        "type": "metric",
        "title": "Open incident picture",
        "width": "half",
        "resource": "incidents",
        "onLoad": "act-incidents-metric-load"
      },
      {
        "id": "alerts-metric",
        "type": "metric",
        "title": "Alerts",
        "width": "half",
        "resource": "alerts",
        "onLoad": "act-alerts-metric-load"
      },
      {
        "id": "maintenance-metric",
        "type": "metric",
        "title": "Work in progress",
        "width": "half",
        "resource": "maintenance",
        "onLoad": "act-maintenance-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Your infrastructure",
        "width": "full"
      },
      {
        "id": "incidents-table",
        "type": "list",
        "title": "Incident picture",
        "width": "full",
        "columns": [
          "id",
          "incident_number",
          "title",
          "category",
          "severity",
          "status",
          "address"
        ],
        "resource": "incidents",
        "onLoad": "act-incidents-table-load",
        "onRowClick": "act-incidents-table-row",
        "onExport": "act-incidents-table-export"
      },
      {
        "id": "alerts-table",
        "type": "table",
        "title": "Public alert context",
        "width": "full",
        "columns": [
          "id",
          "alert_type",
          "severity",
          "status",
          "message"
        ],
        "resource": "alerts",
        "onLoad": "act-alerts-table-load",
        "onRowClick": "act-alerts-table-row",
        "onExport": "act-alerts-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "incident-report",
        "type": "form",
        "title": "Report an infrastructure issue",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "title",
            "type": "text",
            "label": "What is happening?",
            "required": true
          },
          {
            "name": "category",
            "type": "text",
            "label": "Category",
            "required": true
          },
          {
            "name": "severity",
            "type": "text",
            "label": "Severity"
          },
          {
            "name": "description",
            "type": "textarea",
            "label": "Details"
          },
          {
            "name": "address",
            "type": "text",
            "label": "Location"
          }
        ],
        "resource": "incidents",
        "workflowRef": {
          "name": "city-incident-create",
          "checksum": "fb09d3dbb17caee462140d974b5493ff72058fb66da0a41308f97797b471d744"
        },
        "onSubmit": "act-incident-report-submit"
