    {
      "id": "merge-primary",
      "name": "Merge primary annotation",
      "type": "code",
      "typeVersion": 2,
      "position": [
        5040,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst state = response.input;\nif (response.statusCode !== 200 || !response.body || !Array.isArray(response.body.items)) throw new Error('sidecar_query_failed');\nconst primaryId = state.primary.id;\nconst internalId = 'internal-' + primaryId;\nconst item = response.body.items.find((entry) => String(entry.id) === internalId)\n  || response.body.items.find((entry) => String(entry.id) === primaryId)\n  || null;\nconst exists = Boolean(item && Number.isInteger(item.version));\nconst current = exists ? item.data : {};\nconst sidecarId = exists ? String(item.id) : internalId;\nconst closedIds = state.closedIds || [];\nconst existing = [\n  ...(Array.isArray(current.merged_reporter_ids) ? current.merged_reporter_ids : []),\n  ...(Array.isArray(state.primary.data.merged_reporter_ids) ? state.primary.data.merged_reporter_ids : []),\n].map((entry) => String(entry || '')).filter(Boolean);\nconst merged = [...new Set([...existing, ...closedIds])].sort();\nconst data = {\n  ...current,\n  id: sidecarId,\n  incident_id: primaryId,\n  merged_reporter_ids: merged,\n  merge_notes: state.mergeNotes,\n  updated_at: $now,\n};\nconst body = exists ? { data, ifVersion: item.version, publish: false } : { data, publish: false };\nreturn {\n  primary: state.primary,\n  duplicateIds: state.duplicateIds,\n  mergeNotes: state.mergeNotes,\n  missing: state.missing,\n  closedIds,\n  merged_reporter_ids: merged,\n  audit: state.action.audit,\n  sidecar: {\n    exists,\n    url: 'https://synapsedx.sbs/v1/capabilities/datasets/city-incident-internal/records/' + encodeURIComponent(sidecarId),\n    body,\n  },\n};"
      }
