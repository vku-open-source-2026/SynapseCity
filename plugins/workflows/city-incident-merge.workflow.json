        640,
        300
      ],
      "parameters": {
        "url": "={{ 'https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/' + $json.encodedId }}",
        "method": "GET",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "auth": {
          "credentialRef": "synapsedx-organization",
          "header": "X-API-Key",
