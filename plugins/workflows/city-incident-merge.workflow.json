    {
      "id": "summarize-merge",
      "name": "Summarize merge",
      "type": "code",
      "typeVersion": 2,
      "position": [
        5480,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst state = response.input;\nif (response.statusCode !== 200 && response.statusCode !== 201) throw new Error('primary_write_failed');\nconst closed = state.closedIds;\nconst failed = state.duplicateIds\n  .filter((duplicate) => !closed.includes(duplicate))\n  .map((duplicate) => {\n    const known = (state.missing || []).find((entry) => entry.id === duplicate);\n    return { id: duplicate, error: known ? known.error : 'close_failed' };\n  });\nreturn {\n  operation: 'incidents.merge',\n  incident_id: state.audit.recordId,\n  closed,\n  failed,\n  merged_reporter_ids: state.body.data.merged_reporter_ids,\n};"
      }
    }
