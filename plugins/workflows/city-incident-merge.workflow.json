    {
      "id": "plan-closes",
      "name": "Plan duplicate closes",
      "type": "code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst state = response.input;\nif (response.statusCode !== 200 || !response.body || !Array.isArray(response.body.items)) throw new Error('duplicate_query_failed');\nconst INTERNAL_FIELDS = [\"reported_by\",\"contact_info\",\"reporter_name\",\"reporter_phone\",\"reporter_email\",\"reporter_id_card\",\"internal_notes\",\"internal_attachments\",\"assigned_to\",\"assigned_at\",\"resolution_notes\",\"merged_reporter_ids\",\"maintenance_record_id\",\"cost_status\",\"cost_approved_at\",\"cost_approval_id\",\"cost_approved_by\",\"cost_approval_roles\",\"reporter_type\",\"internal_comments\",\"upvoters\",\"merge_notes\"];\nconst found = new Map(response.body.items.map((item) => [String(item.id), item]));\nconst slots = [];\nconst missing = [];\nfor (const duplicateId of state.duplicateIds) {\n  const item = found.get(String(duplicateId));\n  if (!item || typeof item.data !== 'object' || !item.data || !Number.isInteger(item.version)) {\n    missing.push({ id: duplicateId, error: 'not_found' });\n    continue;\n  }\n  const next = { ...item.data };\n  for (const field of INTERNAL_FIELDS) delete next[field];\n  next.comments = (Array.isArray(item.data.comments) ? item.data.comments : [])\n    .filter((entry) => entry && entry.is_internal !== true)\n    .map((entry) => {\n      const clean = {};\n      for (const key of ['id', 'comment', 'posted_at', 'created_at']) if (entry[key] !== undefined) clean[key] = entry[key];\n      clean.is_internal = false;\n      if (entry.public_author === true && entry.user_name) clean.user_name = entry.user_name;\n      return clean;\n    });\n  Object.assign(next, {\n    status: 'closed',\n    resolution_type: 'duplicate',\n    merged_into: state.primary.id,\n    closed_at: $now,\n  });\n  slots.push({\n    exists: true,\n    url: 'https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/' + encodeURIComponent(String(duplicateId)),\n    body: { data: next, ifVersion: item.version, publish: false },\n  });\n}\nwhile (slots.length < 5) slots.push({ exists: false });\nreturn {\n  action: state.action,\n  primary: state.primary,\n  duplicateIds: state.duplicateIds,\n  mergeNotes: state.mergeNotes,\n  missing,\n  slots,\n  query: { where: { or: state.duplicateIds.map((duplicate) => ({ id: duplicate })) }, limit: 100 },\n  sidecarQuery: { where: { or: [{ id: 'internal-' + state.primary.id }, { id: state.primary.id }] }, limit: 2 },\n};"
      }
    },
