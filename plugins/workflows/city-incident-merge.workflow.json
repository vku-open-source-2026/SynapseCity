    {
      "id": "validate-envelope",
      "name": "Validate DX envelope and action fields",
      "type": "code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "code": "const envelope = $input || {};\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\nconst envelopeKeys = new Set(['pluginId', 'widgetId', 'product', 'resource', 'submittedBy', 'submittedAt', 'action', 'fields']);\nconst unknownEnvelope = Object.keys(envelope).filter((key) => !envelopeKeys.has(key));\nif (unknownEnvelope.length) throw new Error('unknown_envelope_fields:' + unknownEnvelope.join(','));\nconst product = text(envelope.product);\nconst resource = text(envelope.resource);\nconst submittedBy = text(envelope.submittedBy);\nif (!submittedBy) throw new Error('submitted_by_required');\nconst fields = envelope.fields && typeof envelope.fields === 'object' && !Array.isArray(envelope.fields) ? envelope.fields : null;\nif (!fields) throw new Error('fields_required');\nif (product !== 'city') throw new Error('unsupported_product');\nif (resource !== 'incidents') throw new Error('unsupported_resource');\nconst recordId = text(fields.incident_id);\nif (!/^[A-Za-z0-9_@.:+-]{1,256}$/.test(recordId)) throw new Error('record_id_invalid');\nconst encodedId = encodeURIComponent(recordId);\nconst allowed = new Set([\"incident_id\",\"duplicate_ids\",\"merge_notes\"]);\nconst unknown = Object.keys(fields).filter((key) => !allowed.has(key));\nif (unknown.length) throw new Error('unknown_fields:' + unknown.join(','));\nconst rawDuplicates = text(fields.duplicate_ids);\nif (!rawDuplicates) throw new Error('duplicate_ids_required');\nconst duplicateIds = [...new Set(rawDuplicates.split(',').map((entry) => entry.trim()).filter((entry) => entry))];\nif (duplicateIds.length < 1 || duplicateIds.length > 5) throw new Error('duplicate_ids_limit_1_5');\nfor (const duplicate of duplicateIds) {\n  if (!/^[A-Za-z0-9_@.:+-]{1,256}$/.test(duplicate)) throw new Error('duplicate_id_invalid:' + duplicate);\n  if (duplicate === recordId) throw new Error('duplicate_is_primary');\n}\nconst mergeNotes = text(fields.merge_notes);\nif (mergeNotes.length > 4000) throw new Error('merge_notes_max_4000');\nconst audit = {\n  product, resource, operation: 'incidents.merge', recordId,\n  pluginId: text(envelope.pluginId), widgetId: text(envelope.widgetId),\n  submittedBy, submittedAt: text(envelope.submittedAt) || $now,\n};\n\nreturn { recordId, encodedId, duplicateIds, mergeNotes, audit, operation: 'incidents.merge' };"
      }
    },
    {
      "id": "http-get-primary",
