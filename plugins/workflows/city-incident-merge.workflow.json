    {
      "id": "prepare-query",
      "name": "Prepare duplicate query",
      "type": "code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst current = response.body;\nconst action = response.input;\nif (response.statusCode !== 200 || !current || typeof current.data !== 'object' || !current.data) throw new Error('record_not_found');\nconst primary = current.data;\nif (!Number.isInteger(current.version)) throw new Error('record_version_unavailable');\nconst primaryId = String(primary.id || action.recordId);\nconst mergeNotes = action.mergeNotes || 'Merged into ' + String(primary.incident_number || primaryId);\nreturn {\n  action,\n  primary: { id: primaryId, data: primary, version: current.version, encodedId: action.encodedId },\n  duplicateIds: action.duplicateIds,\n  mergeNotes,\n  query: { where: { or: action.duplicateIds.map((duplicate) => ({ id: duplicate })) }, limit: 100 },\n};"
      }
    },
    {
      "id": "http-query-duplicates",
      "name": "Query duplicate incidents",
      "type": "httpRequest",
      "typeVersion": 4,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "url": "https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/query",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "auth": {
          "credentialRef": "synapsedx-organization",
          "header": "X-API-Key",
          "allowedOrigins": [
            "https://synapsedx.sbs"
          ]
        },
