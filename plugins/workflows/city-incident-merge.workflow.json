    {
      "id": "validate-envelope",
      "name": "Validate DX envelope and action fields",
      "type": "code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "code": "const envelope = $input || {};\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\nconst envelopeKeys = new Set(['pluginId', 'widgetId', 'product', 'resource', 'submittedBy', 'submittedAt', 'action', 'fields']);\nconst unknownEnvelope = Object.keys(envelope).filter((key) => !envelopeKeys.has(key));\nif (unknownEnvelope.length) throw new Error('unknown_envelope_fields:' + unknownEnvelope.join(','));\nconst product = text(envelope.product);\nconst resource = text(envelope.resource);\nconst submittedBy = text(envelope.submittedBy);\nif (!submittedBy) throw new Error('submitted_by_required');\nconst fields = envelope.fields && typeof envelope.fields === 'object' && !Array.isArray(envelope.fields) ? envelope.fields : null;\nif (!fields) throw new Error('fields_required');\nif (product !== 'city') throw new Error('unsupported_product');\nif (resource !== 'incidents') throw new Error('unsupported_resource');\nconst recordId = text(fields.incident_id);\nif (!/^[A-Za-z0-9_@.:+-]{1,256}$/.test(recordId)) throw new Error('record_id_invalid');\nconst encodedId = encodeURIComponent(recordId);\nconst allowed = new Set([\"incident_id\",\"duplicate_ids\",\"merge_notes\"]);\nconst unknown = Object.keys(fields).filter((key) => !allowed.has(key));\nif (unknown.length) throw new Error('unknown_fields:' + unknown.join(','));\nconst rawDuplicates = text(fields.duplicate_ids);\nif (!rawDuplicates) throw new Error('duplicate_ids_required');\nconst duplicateIds = [...new Set(rawDuplicates.split(',').map((entry) => entry.trim()).filter((entry) => entry))];\nif (duplicateIds.length < 1 || duplicateIds.length > 5) throw new Error('duplicate_ids_limit_1_5');\nfor (const duplicate of duplicateIds) {\n  if (!/^[A-Za-z0-9_@.:+-]{1,256}$/.test(duplicate)) throw new Error('duplicate_id_invalid:' + duplicate);\n  if (duplicate === recordId) throw new Error('duplicate_is_primary');\n}\nconst mergeNotes = text(fields.merge_notes);\nif (mergeNotes.length > 4000) throw new Error('merge_notes_max_4000');\nconst audit = {\n  product, resource, operation: 'incidents.merge', recordId,\n  pluginId: text(envelope.pluginId), widgetId: text(envelope.widgetId),\n  submittedBy, submittedAt: text(envelope.submittedAt) || $now,\n};\n\nreturn { recordId, encodedId, duplicateIds, mergeNotes, audit, operation: 'incidents.merge' };"
      }
    },
    {
      "id": "http-get-primary",
      "name": "Read primary incident",
      "type": "httpRequest",
      "typeVersion": 4,
      "position": [
        640,
        300
      ],
      "parameters": {
        "url": "={{ 'https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/' + $json.encodedId }}",
        "method": "GET",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "auth": {
          "credentialRef": "synapsedx-organization",
          "header": "X-API-Key",
          "allowedOrigins": [
            "https://synapsedx.sbs"
          ]
        },
        "includeInput": true,
        "timeoutMs": 15000
      }
    },
    {
      "id": "prepare-query",
      "name": "Prepare duplicate query",
      "type": "code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst current = response.body;\nconst action = response.input;\nif (response.statusCode !== 200 || !current || typeof current.data !== 'object' || !current.data) throw new Error('record_not_found');\nconst primary = current.data;\nif (!Number.isInteger(current.version)) throw new Error('record_version_unavailable');\nconst primaryId = String(primary.id || action.recordId);\nconst mergeNotes = action.mergeNotes || 'Merged into ' + String(primary.incident_number || primaryId);\nreturn {\n  action,\n  primary: { id: primaryId, data: primary, version: current.version, encodedId: action.encodedId },\n  duplicateIds: action.duplicateIds,\n  mergeNotes,\n  query: { where: { or: action.duplicateIds.map((duplicate) => ({ id: duplicate })) }, limit: 100 },\n};"
      }
    },
    {
      "id": "http-query-duplicates",
      "name": "Query duplicate incidents",
      "type": "httpRequest",
      "typeVersion": 4,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "url": "https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/query",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "auth": {
          "credentialRef": "synapsedx-organization",
          "header": "X-API-Key",
          "allowedOrigins": [
            "https://synapsedx.sbs"
          ]
        },
        "body": "={{ $json.query }}",
        "includeInput": true,
        "timeoutMs": 15000
      }
    },
    {
      "id": "plan-closes",
      "name": "Plan duplicate closes",
      "type": "code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst state = response.input;\nif (response.statusCode !== 200 || !response.body || !Array.isArray(response.body.items)) throw new Error('duplicate_query_failed');\nconst found = new Map(response.body.items.map((item) => [String(item.id), item]));\nconst slots = [];\nconst missing = [];\nfor (const duplicateId of state.duplicateIds) {\n  const item = found.get(String(duplicateId));\n  if (!item || typeof item.data !== 'object' || !item.data || !Number.isInteger(item.version)) {\n    missing.push({ id: duplicateId, error: 'not_found' });\n    continue;\n  }\n  slots.push({\n    exists: true,\n    url: 'https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/' + encodeURIComponent(String(duplicateId)),\n    body: {\n      data: {\n        ...item.data,\n        status: 'closed',\n        resolution_type: 'duplicate',\n        merged_into: state.primary.id,\n        resolution_notes: state.mergeNotes,\n        closed_at: $now,\n      },\n      ifVersion: item.version,\n      publish: false,\n    },\n  });\n}\nwhile (slots.length < 5) slots.push({ exists: false });\nreturn {\n  action: state.action,\n  primary: state.primary,\n  duplicateIds: state.duplicateIds,\n  mergeNotes: state.mergeNotes,\n  missing,\n  slots,\n  query: { where: { or: state.duplicateIds.map((duplicate) => ({ id: duplicate })) }, limit: 100 },\n};"
      }
    },
