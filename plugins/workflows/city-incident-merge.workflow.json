    {
      "id": "collect-closed-duplicates",
      "name": "Collect closed duplicate ids",
      "type": "code",
      "typeVersion": 2,
      "position": [
        4820,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst state = response.input || {};\nif (response.statusCode !== 200 || !response.body || !Array.isArray(response.body.items)) throw new Error('duplicate_requery_failed');\nconst closedIds = [];\nfor (const item of response.body.items) {\n  const data = item && typeof item.data === 'object' && item.data ? item.data : null;\n  if (data && String(data.status) === 'closed' && String(data.merged_into) === String(state.primary.id)) {\n    closedIds.push(String(item.id));\n  }\n}\nreturn { ...state, closedIds };"
      }
    },
    {
