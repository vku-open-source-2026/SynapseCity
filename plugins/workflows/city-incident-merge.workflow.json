    {
      "id": "merge-primary",
      "name": "Merge primary annotation",
      "type": "code",
      "typeVersion": 2,
      "position": [
        5040,
        300
      ],
      "parameters": {
        "code": "const response = $input || {};\nconst state = response.input;\nif (response.statusCode !== 200 || !response.body || !Array.isArray(response.body.items)) throw new Error('duplicate_requery_failed');\nconst primaryId = state.primary.id;\nconst closedIds = [];\nfor (const item of response.body.items) {\n  const data = item && typeof item.data === 'object' && item.data ? item.data : null;\n  if (!data) continue;\n  if (String(data.status) === 'closed' && String(data.merged_into) === String(primaryId)) {\n    closedIds.push(String(item.id));\n  }\n}\nconst existing = Array.isArray(state.primary.data.merged_reporter_ids)\n  ? state.primary.data.merged_reporter_ids.map((entry) => String(entry || '')).filter((entry) => entry)\n  : [];\nconst merged = [...new Set([...existing, ...closedIds])].sort();\nconst next = { ...state.primary.data, merged_reporter_ids: merged };\nreturn {\n  body: { data: next, ifVersion: state.primary.version, publish: false },\n  url: 'https://synapsedx.sbs/v1/capabilities/datasets/city-incidents/records/' + state.primary.encodedId,\n  closedIds,\n  missing: state.missing,\n  duplicateIds: state.duplicateIds,\n  audit: state.action.audit,\n};"
      }
    },
