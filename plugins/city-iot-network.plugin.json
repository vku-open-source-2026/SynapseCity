{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "city",
    "name": "City IoT network",
    "slug": "city-iot-network",
    "audience": "admin",
    "roles": [
      "admin",
      "manager"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Keep the sensor registry current and ingest observations into the Tier-2 IoT datasets. Thresholds and metadata are JSON strings reviewed by the City action workflow.",
        "type": "heading",
        "title": "Sensors and readings",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:city-operations-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Assets",
            "target": "page:city-asset-registry",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Incidents",
            "target": "page:city-incident-desk",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Maintenance",
            "target": "page:city-maintenance-workshop",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "iot-metric",
        "type": "metric",
        "title": "Sensors",
        "width": "half",
        "resource": "iot",
        "onLoad": "act-iot-metric-load"
      },
      {
        "id": "readings-metric",
        "type": "metric",
        "title": "Readings",
        "width": "half",
        "resource": "iotReadings",
        "onLoad": "act-readings-metric-load"
      },
      {
        "id": "readings-chart",
        "type": "chart",
        "title": "Readings average by sensor",
        "width": "full",
        "resource": "iotReadings",
        "columns": [
          "sensor_id",
          "value"
        ],
        "chartType": "bar",
        "aggregation": "average",
        "onLoad": "act-readings-chart-load"
      },
      {
        "id": "alerts-metric",
        "type": "metric",
        "title": "Alerts",
        "width": "half",
        "resource": "alerts",
        "onLoad": "act-alerts-metric-load"
      },
      {
        "id": "iot-map",
        "type": "map",
        "title": "Iot · Live map",
        "width": "full",
        "resource": "iot",
        "columns": [
          "id",
          "name",
          "title",
          "status",
          "severity",
          "address",
          "district",
          "latitude",
          "longitude",
          "geometry",
          "geometry_json",
          "location",
          "current_location",
          "current_location_json"
        ],
        "onLoad": "act-iot-map-load",
        "onRowClick": "act-iot-map-row",
        "onExport": "act-iot-map-export"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Your infrastructure",
        "width": "full"
      },
      {
        "id": "iot-table",
        "type": "table",
        "title": "Sensor registry",
        "width": "full",
        "columns": [
          "id",
          "sensor_code",
          "asset_id",
          "sensor_type",
          "status",
          "measurement_unit",
          "last_seen",
          "last_reading"
        ],
        "resource": "iot",
        "onLoad": "act-iot-table-load",
        "onRowClick": "act-iot-table-row",
        "onExport": "act-iot-table-export"
      },
      {
        "id": "readings-table",
        "type": "table",
        "title": "Recent readings",
        "width": "full",
        "columns": [
          "id",
          "sensor_id",
          "timestamp",
          "value"
        ],
        "resource": "iotReadings",
        "onLoad": "act-readings-table-load",
        "onRowClick": "act-readings-table-row",
        "onExport": "act-readings-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "sensor-create",
        "type": "form",
        "title": "Register a sensor",
        "width": "full",
        "action": "create",
        "fields": [
          {
            "name": "sensor_code",
            "type": "text",
            "label": "Sensor code",
            "required": true
          },
          {
            "name": "asset_id",
            "type": "text",
            "label": "Asset id",
            "required": true
          },
          {
            "name": "sensor_type",
            "type": "text",
            "label": "Sensor type",
            "required": true
          },
          {
            "name": "status",
            "type": "text",
            "label": "Status"
          },
          {
            "name": "measurement_unit",
            "type": "text",
            "label": "Measurement unit"
          },
          {
            "name": "latitude",
            "type": "number",
            "label": "Latitude"
          },
          {
            "name": "longitude",
            "type": "number",
            "label": "Longitude"
          },
          {
            "name": "threshold_json",
            "type": "json",
            "label": "Thresholds (JSON)",
            "selectionPath": "threshold"
          }
        ],
        "resource": "iot",
        "workflowRef": {
          "name": "city-workspace-actions",
          "checksum": "4490b325eb2b06e4c699ea2bafb51a74347aca7a76b4ee43c5cf77a144efbe63"
        },
        "onSubmit": "act-sensor-create-submit"
      },
      {
        "id": "sensor-update",
        "type": "form",
        "title": "Update a sensor",
        "width": "half",
        "action": "update",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Sensor id",
            "required": true
          },
          {
            "name": "sensor_type",
            "type": "text",
            "label": "Sensor type"
          },
          {
            "name": "status",
            "type": "text",
            "label": "Status"
          },
          {
            "name": "measurement_unit",
            "type": "text",
            "label": "Measurement unit"
          },
          {
            "name": "latitude",
            "type": "number",
            "label": "Latitude"
          },
          {
            "name": "longitude",
            "type": "number",
            "label": "Longitude"
          },
          {
            "name": "threshold_json",
            "type": "json",
            "label": "Thresholds (JSON)",
            "selectionPath": "threshold"
          }
        ],
        "resource": "iot",
        "workflowRef": {
          "name": "city-workspace-actions",
          "checksum": "4490b325eb2b06e4c699ea2bafb51a74347aca7a76b4ee43c5cf77a144efbe63"
        },
        "onSubmit": "act-sensor-update-submit"
      },
      {
        "id": "sensor-delete",
        "type": "form",
        "title": "Retire a sensor",
        "width": "half",
        "action": "delete",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Sensor id",
            "required": true
          }
        ],
        "resource": "iot",
        "workflowRef": {
          "name": "city-workspace-actions",
          "checksum": "4490b325eb2b06e4c699ea2bafb51a74347aca7a76b4ee43c5cf77a144efbe63"
        },
        "onSubmit": "act-sensor-delete-submit"
      },
      {
        "id": "reading-create",
        "type": "form",
        "title": "Ingest a reading",
        "width": "half",
        "action": "create",
        "fields": [
          {
            "name": "sensor_id",
            "type": "text",
            "label": "Sensor id",
            "required": true
          },
          {
            "name": "value",
            "type": "number",
            "label": "Value",
            "required": true
          },
          {
            "name": "timestamp",
            "type": "text",
            "label": "Timestamp"
          },
          {
            "name": "metadata_json",
            "type": "json",
            "label": "Metadata (JSON)",
            "selectionPath": "metadata"
          }
        ],
        "resource": "iotReadings",
        "workflowRef": {
          "name": "city-workspace-actions",
          "checksum": "4490b325eb2b06e4c699ea2bafb51a74347aca7a76b4ee43c5cf77a144efbe63"
        },
        "onSubmit": "act-reading-create-submit"
      },
      {
        "id": "iot-batch",
        "type": "form",
        "presentation": "inline",
        "title": "Batch-ingest sensor readings (CSV)",
        "width": "full",
        "resource": "iotReadings",
        "action": "execute",
        "workflowRef": {
          "name": "city-iot-batch",
          "checksum": "65da1426b306fd031c71d09eac8c2601f2e3c1a295f1ace47882504053d64d7c"
        },
        "onSubmit": "import-all-iot-batches",
        "fields": [
          {
            "name": "file_id",
            "label": "Readings CSV",
            "type": "file",
            "accept": "text/csv,application/vnd.ms-excel,application/octet-stream",
            "maxBytes": 10485760,
            "required": true,
            "uploadAction": "act-iot-batch-upload-file-id"
          },
          {
            "name": "batch_offset",
            "label": "Resume at row offset",
            "type": "number",
            "defaultValue": "0"
          }
        ]
      },
      {
        "id": "import-all-iot-batches",
        "type": "action",
        "title": "Import all readings batches",
        "operation": {
          "kind": "batch",
          "target": "iot-batch",
          "source": "batch_offset",
          "mappings": [
            {
              "field": "file_id",
              "source": "event",
              "value": "values.file_id",
              "required": true
            },
            {
              "field": "batch_offset",
              "source": "event",
              "value": "values.batch_offset",
              "required": false
            }
          ],
          "javascript": "",
          "inputs": [],
          "actions": []
        }
      },
      {
        "id": "iot-batch-help",
        "type": "markdown",
        "title": "Readings CSV format",
        "width": "full",
        "text": "Required columns: sensor_id, value (number). Optional: timestamp (ISO date), metadata (JSON). Rows are validated per row and created as private SensorReading records; the job summary reports imported, skipped and invalid rows with row numbers."
      },
