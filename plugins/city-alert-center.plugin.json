      "manager"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Acknowledge, resolve or dismiss operational alerts generated by sensors and incident automation. Alert writes share the City alert dataset and remain tenant-scoped.",
        "type": "text",
        "title": "Infrastructure alert triage",
        "width": "full"
      },
      {
        "id": "alerts-metric",
        "type": "metric",
        "title": "Alerts",
        "width": "half",
        "resource": "alerts"
      },
      {
        "id": "incidents-metric",
        "type": "metric",
        "title": "Incidents",
        "width": "half",
        "resource": "incidents"
      },
      {
        "id": "iot-metric",
        "type": "metric",
        "title": "Sensors reporting",
        "width": "half",
        "resource": "iot"
      },
      {
        "id": "alerts-table",
        "type": "table",
        "title": "Alert feed",
        "width": "full",
        "columns": [
          "id",
          "alert_type",
          "severity",
          "status",
          "asset_id",
          "sensor_id",
          "message",
          "acknowledged_at",
          "resolved_at"
