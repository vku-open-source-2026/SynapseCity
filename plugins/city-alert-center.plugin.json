      {
        "id": "intro",
        "text": "Acknowledge, resolve or dismiss operational alerts generated by sensors and incident automation. Alert writes share the City alert dataset and remain tenant-scoped.",
        "type": "heading",
        "title": "Infrastructure alert triage",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:city-operations-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Assets",
            "target": "page:city-asset-registry",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Incidents",
            "target": "page:city-incident-desk",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Maintenance",
            "target": "page:city-maintenance-workshop",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
