            "label": "Severity"
          },
          {
            "name": "asset_id",
            "type": "text",
            "label": "Asset id"
          },
          {
            "name": "sensor_id",
            "type": "text",
            "label": "Sensor id"
          },
          {
            "name": "metadata_json",
            "type": "textarea",
            "label": "Metadata (JSON)"
          }
        ],
        "resource": "alerts",
