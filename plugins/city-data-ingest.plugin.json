        "operation": {
          "kind": "navigate",
          "mappings": [],
          "javascript": "",
          "inputs": [],
          "actions": [],
          "destination": "module:tasks"
        }
      },
      {
        "id": "act-ingest-metric-load",
        "type": "action",
        "title": "Read Ingest jobs",
        "operation": {
          "kind": "query",
          "target": "ingest-metric",
          "mappings": [
            {
              "field": "limit",
              "source": "event",
              "value": "limit"
            },
            {
              "field": "offset",
              "source": "event",
              "value": "offset"
            },
            {
              "field": "search",
              "source": "event",
              "value": "search"
            }
          ],
          "javascript": "",
