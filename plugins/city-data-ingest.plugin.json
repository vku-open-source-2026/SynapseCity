{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "city",
    "name": "City data ingest",
    "slug": "city-data-ingest",
    "audience": "admin",
    "roles": [
      "admin",
      "manager"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Upload and preview a CSV, then import assets in validated batches. Processing results show imported, duplicate and invalid rows; retrying preserves existing records.",
        "type": "heading",
        "title": "CSV and batch ingest jobs",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:city-operations-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Assets",
            "target": "page:city-asset-registry",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Incidents",
            "target": "page:city-incident-desk",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Maintenance",
            "target": "page:city-maintenance-workshop",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "ingest-metric",
        "type": "metric",
        "title": "Ingest jobs",
        "width": "half",
        "resource": "ingest",
        "onLoad": "act-ingest-metric-load"
      },
      {
        "id": "files-metric",
        "type": "metric",
        "title": "Stored files",
        "width": "half",
        "resource": "commonFiles",
        "onLoad": "act-files-metric-load"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Your infrastructure",
        "width": "full"
      },
      {
        "id": "ingest-table",
        "type": "table",
        "title": "Ingest jobs",
        "width": "full",
        "columns": [
          "id",
          "file_name",
          "status",
          "rows_total",
          "batch_offset",
          "rows_processed",
          "rows_imported",
          "rows_skipped",
          "rows_invalid",
          "created_at"
        ],
        "resource": "ingest",
        "onLoad": "act-ingest-table-load",
        "onRowClick": "act-ingest-table-row",
        "onExport": "act-ingest-table-export"
      },
      {
        "id": "files-table",
        "type": "table",
        "title": "File registry",
        "width": "full",
        "columns": [
          "id",
          "filename",
          "contentType",
          "size",
          "createdAt"
        ],
        "resource": "commonFiles",
        "onLoad": "act-files-table-load",
        "onRowClick": "act-files-table-row",
        "onExport": "act-files-table-export"
      },
      {
        "id": "actions-section",
        "type": "divider",
        "title": "Take action",
        "width": "full"
      },
      {
        "id": "ingest-delete",
        "type": "form",
        "title": "Remove a job record",
        "width": "half",
        "action": "delete",
        "fields": [
          {
            "name": "record_id",
            "type": "text",
            "label": "Job id",
            "required": true
          }
        ],
        "resource": "ingest",
        "workflowRef": {
          "name": "city-workspace-actions",
          "checksum": "5992167880202afcd581a2acffd0e87986f656775562da222b728b18d36aa928"
        },
        "onSubmit": "act-ingest-delete-submit"
      },
      {
        "id": "csv-import",
        "type": "form",
        "presentation": "inline",
        "title": "Import asset CSV",
        "width": "full",
        "resource": "ingest",
        "action": "execute",
        "workflowRef": {
          "name": "city-csv-import",
          "checksum": "32dc966208523c4f99b13c34c5cd8e4f3ec8d5889325f1be3ae99e2ed065bfc4"
        },
        "onSubmit": "import-all-csv-batches",
        "fields": [
          {
            "name": "file_id",
            "label": "CSV file",
            "type": "file",
            "accept": "text/csv,application/vnd.ms-excel,application/octet-stream",
            "maxBytes": 10485760,
            "required": true,
            "uploadAction": "act-csv-import-upload-file-id"
          },
          {
            "name": "batch_offset",
            "label": "Resume at row offset",
            "type": "number",
            "defaultValue": "0"
          }
        ]
      },
      {
        "id": "import-all-csv-batches",
        "type": "action",
        "title": "Import all CSV batches",
        "operation": {
          "kind": "batch",
          "target": "csv-import",
          "source": "batch_offset",
          "mappings": [
            {
              "field": "file_id",
              "source": "event",
              "value": "values.file_id",
              "required": true
            },
            {
              "field": "batch_offset",
              "source": "event",
              "value": "values.batch_offset",
              "required": false
            }
          ],
          "javascript": "",
          "inputs": [],
          "actions": []
        }
      },
      {
        "id": "csv-help",
        "type": "markdown",
        "title": "CSV format",
        "width": "full",
        "text": "Required columns: `asset_code`, `name`, `feature_type`, `feature_code`, `latitude`, `longitude`. Optional: `category`, `status`, `address`, `properties` (JSON), `geometry` (GeoJSON). Coordinates must be in geographic range. Up to 50,000 rows per file; results identify row numbers that need correction. Existing asset IDs are skipped."
      },
      {
        "id": "act-workspace-navigation-link1",
        "type": "action",
        "title": "Navigate Overview",
        "operation": {
          "kind": "navigate",
          "mappings": [],
          "javascript": "",
          "inputs": [],
          "actions": [],
          "destination": "page:city-operations-overview"
        }
      },
      {
