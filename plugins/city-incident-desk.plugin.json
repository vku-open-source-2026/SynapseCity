        "width": "half",
        "resource": "maintenance",
        "onLoad": "act-maintenance-metric-load"
      },
      {
        "id": "incidents-map",
        "type": "map",
        "title": "Incidents · Live map",
        "width": "full",
        "resource": "incidents",
        "columns": [
          "id",
          "name",
          "title",
          "status",
          "severity",
          "address",
          "district",
          "latitude",
          "longitude",
          "geometry",
          "geometry_json",
          "location",
          "current_location",
          "current_location_json"
        ],
        "onLoad": "act-incidents-map-load",
        "onRowClick": "act-incidents-map-row",
        "onExport": "act-incidents-map-export"
      },
      {
        "id": "records-section",
        "type": "divider",
        "title": "Your infrastructure",
        "width": "full"
      },
      {
        "id": "incidents-table",
        "type": "table",
        "title": "Incident queue",
        "width": "full",
