        "type": "map",
        "title": "Incidents · Live map",
        "width": "full",
        "resource": "incidents",
        "columns": [
          "id",
          "name",
          "title",
          "status",
          "severity",
          "address",
          "district",
          "latitude",
          "longitude",
          "geometry",
          "geometry_json",
          "location",
          "current_location",
          "current_location_json"
