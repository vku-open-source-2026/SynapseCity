{
  "format": "synapsedx-plugin",
  "formatVersion": 1,
  "plugin": {
    "product": "city",
    "name": "City incident desk",
    "slug": "city-incident-desk",
    "audience": "admin",
    "roles": [
      "admin",
      "manager"
    ],
    "widgets": [
      {
        "id": "intro",
        "text": "Triage citizen and operator reports, assign an owner, record verification and close the loop. Lifecycle transitions use the reviewed City incident workflows and optimistic record versions.",
        "type": "heading",
        "title": "Incident intake and resolution",
        "width": "full"
      },
      {
        "id": "workspace-navigation",
        "type": "navigation",
        "title": "Quick access",
        "width": "full",
        "links": [
          {
            "label": "Overview",
            "target": "page:city-operations-overview",
            "actionId": "act-workspace-navigation-link1"
          },
          {
            "label": "Assets",
            "target": "page:city-asset-registry",
            "actionId": "act-workspace-navigation-link2"
          },
          {
            "label": "Incidents",
            "target": "page:city-incident-desk",
            "actionId": "act-workspace-navigation-link3"
          },
          {
            "label": "Maintenance",
            "target": "page:city-maintenance-workshop",
            "actionId": "act-workspace-navigation-link4"
          },
          {
            "label": "Team tasks",
            "target": "module:tasks",
            "actionId": "act-workspace-navigation-link5"
          }
        ]
      },
      {
        "id": "incidents-metric",
        "type": "metric",
        "title": "Incidents",
        "width": "half",
        "resource": "incidents",
        "onLoad": "act-incidents-metric-load"
      },
      {
        "id": "alerts-metric",
        "type": "metric",
        "title": "Alerts",
        "width": "half",
        "resource": "alerts",
        "onLoad": "act-alerts-metric-load"
      },
      {
        "id": "maintenance-metric",
        "type": "metric",
