        "type": "metric",
        "title": "Assets in the registry",
        "width": "half",
        "resource": "assets"
      },
      {
        "id": "incidents-metric",
        "type": "metric",
        "title": "Incident queue",
        "width": "half",
        "resource": "incidents"
      },
      {
        "id": "maintenance-metric",
